# Copy this file to .env and fill in real values before running docker compose.
# The .env file is git-ignored and must never be committed.

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=travel_admin
POSTGRES_PASSWORD=change_me_strong_password

# =============================================================================
# MinIO (S3-compatible object storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong_password

# =============================================================================
# JWT — Must match Identity service; used by Gateway, Identity, Catalog, Booking,
# Media, Chat. REQUIRED in production — set via env so defaults are never used.
# Generate a random value with: openssl rand -hex 32
# =============================================================================
JWT_SIGNING_KEY=change_me_min_32_characters_for_jwt_signing

# =============================================================================
# Identity service — gRPC service-to-service authentication
# Generate a random value with: openssl rand -hex 32
# =============================================================================
GRPC_INTERNAL_SERVICE_TOKEN=change_me_random_token

# =============================================================================
# Service databases (created by init-db.sql): travel_identity, travel_catalog,
# travel_booking, travel_chat. Connection strings are set in docker-compose.
#
# For local development (without Docker), set these env vars before running
# individual services:
#   ConnectionStrings__IdentityDb=Host=localhost;Database=travel_identity;...
#   ConnectionStrings__CatalogDb=Host=localhost;Database=travel_catalog;...
#   ConnectionStrings__BookingDb=Host=localhost;Database=travel_booking;...
#   ConnectionStrings__DefaultConnection=Host=localhost;Database=travel_chat;...
#   JwtSettings__SigningKey=<min-32-chars>  # REQUIRED for Identity, Booking, Chat, Catalog, Media
# =============================================================================

# =============================================================================
# Frontend — API URL when frontend and Gateway run on different origins.
# Optional. If unset, frontend uses relative /api/v1 (works when proxied).
# Example for Docker: frontend on :3000, Gateway on :5000:
# VITE_API_URL=http://localhost:5000/api/v1
# =============================================================================
# VITE_API_URL=
