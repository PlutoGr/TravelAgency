# Режим «домен + HTTPS». Шаблон: nginx-entrypoint.sh подставляет ${SITE_DOMAIN}, ${TA_CERT} и ${TA_KEY}
# (envsubst только по этим трём переменным, переменные nginx вида $host не трогаются).
# SITE_DOMAIN задаётся одной строкой в /opt/travelagency/docker/.env на сервере.
#
# access_log ta_masked задаётся ровно один раз в каждом блоке server ниже.
# В подключаемых файлах (app.conf и default/*.conf) его нет: две директивы в одном server
# дают две одинаковые строки на каждый запрос (#157).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Basic auth dev-окружения не должен уходить в gateway: иначе gateway видит заголовок Authorization
# и не подставляет Bearer из cookie access_token. Заголовок Basic убираем, Bearer передаём как есть.
map $http_authorization $upstream_authorization {
    default    $http_authorization;
    "~*^Basic " "";
}

# HTTP для домена: проверка Let's Encrypt (HTTP-01) без пароля, остальное на HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${SITE_DOMAIN};
    server_tokens off;
    access_log /var/log/nginx/access.log ta_masked;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://${SITE_DOMAIN}$request_uri;
    }
}

# Заход по IP или чужому имени. Что делать, выбирает nginx-entrypoint.sh:
#   нет сертификата Let's Encrypt -> default/fallback-*.conf (сайт как раньше, без редиректа на домен);
#   сертификат есть               -> default/redirect-*.conf (301 на https://${SITE_DOMAIN}).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log ta_masked;

    # Проверка Let's Encrypt работает в обоих режимах
    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    include /etc/nginx/travelagency/default-http.conf;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;
    # server_tokens off задаёт подключаемый файл (в fallback он приходит из app.conf)
    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;
    access_log /var/log/nginx/access.log ta_masked;

    include /etc/nginx/travelagency/default-https.conf;
}

# Основной сайт.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    # Let's Encrypt (/etc/letsencrypt/live/<домен>/), а пока его нет, самоподписанный (см. entrypoint)
    ssl_certificate     ${TA_CERT};
    ssl_certificate_key ${TA_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    access_log /var/log/nginx/access.log ta_masked;

    # HSTS пока не включаем: домен dev может смениться, а HSTS браузер помнит долго.
    # add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/travelagency/app.conf;
}
