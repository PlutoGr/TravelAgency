{
  "ConnectionStrings": {
    "_comment": "ConnectionStrings:MediaDb is required. Set ConnectionStrings__MediaDb env var or add to configuration."
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"]
  },
  "JwtSettings": {
    "Issuer": "TravelAgency.Identity",
    "Audience": "TravelAgency",
    "ValidateLifetime": true
  },
  "GrpcSettings": {
    "InternalServiceToken": ""
  },
  "Storage": {
    "ServiceUrl": "http://minio:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "media",
    "ForcePathStyle": true,
    "PresignTtlMinutes": 60
  },
  "Upload": {
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": ["image/jpeg", "image/png", "image/webp", "image/gif", "application/pdf"],
    "ThumbnailWidths": [200, 800]
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "AllowedHosts": "*"
}
