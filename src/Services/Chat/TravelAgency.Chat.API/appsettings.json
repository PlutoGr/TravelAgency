{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "_comment": "Override via ConnectionStrings__ChatDb / ConnectionStrings__DefaultConnection env var.",
    "ChatDb": "Host=localhost;Database=chat-db;Username=postgres;Password=REPLACE_VIA_ENV",
    "DefaultConnection": "Host=localhost;Database=chat-db;Username=postgres;Password=REPLACE_VIA_ENV"
  },
  "JwtSettings": {
    "_comment": "JwtSettings__SigningKey MUST be set via env in production. Never use defaults.",
    "Issuer": "TravelAgency.Identity",
    "Audience": "TravelAgency",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 60,
    "ValidateLifetime": true
  },
  "Services": {
    "BookingServiceUrl": "http://localhost:5030"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5000" ]
  }
}
