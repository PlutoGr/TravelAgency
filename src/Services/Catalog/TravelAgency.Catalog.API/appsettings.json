{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "ConnectionStrings": {
    "_comment": "ConnectionStrings:CatalogDb is required. Set ConnectionStrings__CatalogDb env var or add to configuration."
  },
  "JwtSettings": {
    "Issuer": "TravelAgency.Identity",
    "Audience": "TravelAgency"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "GrpcSettings": {
    "InternalServiceToken": ""
  },
  "GrpcClients": {
    "MediaServiceUrl": "http://media-service:8081"
  },
  "AllowedHosts": "*"
}
