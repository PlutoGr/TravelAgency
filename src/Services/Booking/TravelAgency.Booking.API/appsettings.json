{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "_comment": "ConnectionStrings:BookingDb is required. Set ConnectionStrings__BookingDb env var or add to configuration."
  },
  "JwtSettings": {
    "_comment": "JwtSettings__SigningKey MUST be set via env in production. Never use defaults.",
    "Issuer": "TravelAgency.Identity",
    "Audience": "TravelAgency",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 15,
    "ValidateLifetime": true
  },
  "GrpcSettings": {
    "InternalServiceToken": ""
  },
  "GrpcClients": {
    "CatalogServiceUrl": "http://catalog-service:8081",
    "IdentityServiceUrl": "http://identity-service:8081"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  }
}
