{
  "ConnectionStrings": {
    "_comment": "Set ConnectionStrings__Redis (e.g. redis:6379) for distributed rate limiting across gateway instances. When Redis is not configured, in-memory rate limiting is used (single-instance only)."
  },
  "AuthRoute": {
    "_comment": "Paths must match ReverseProxy route /api/v1/auth/{**catch-all}. Override via AuthRoute__* env vars.",
    "RouteId": "auth-route",
    "BasePath": "/api/v1/auth",
    "RefreshPath": "/api/v1/auth/refresh",
    "LogoutPath": "/api/v1/auth/logout",
    "TokenResponsePaths": ["/api/v1/auth/login", "/api/v1/auth/register", "/api/v1/auth/refresh"]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"]
  },
  "Cookie": {
    "_comment": "Production: Secure=true (HTTPS), SameSite=Lax, Path=/ or /api/v1. Override Domain via Cookie__Domain env var if needed for subdomain sharing.",
    "Secure": true,
    "Path": "/",
    "SameSite": "Lax",
    "AccessTokenName": "access_token",
    "RefreshTokenName": "refresh_token"
  },
  "JwtSettings": {
    "Issuer": "TravelAgency.Identity",
    "Audience": "TravelAgency",
    "ValidateLifetime": true
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}",
          "Methods": ["GET", "POST", "PATCH"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/auth" },
          { "PathPrefix": "/identity" }
        ]
      },
      "catalog-public-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "catalog-manage-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "RequireManagerOrAdmin",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}",
          "Methods": ["POST", "PUT", "PATCH", "DELETE"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "bookings-route": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": {
          "Path": "/api/v1/bookings/{**catch-all}",
          "Methods": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "favorites-route": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": {
          "Path": "/api/v1/favorites/{**catch-all}",
          "Methods": ["GET", "POST", "DELETE"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "chat-route": {
        "ClusterId": "chat-cluster",
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": {
          "Path": "/api/v1/chat/{**catch-all}",
          "Methods": ["GET", "POST"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "media-files-public-route": {
        "ClusterId": "media-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/v1/media/files/{**catch-all}",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "media-manage-files-route": {
        "ClusterId": "media-cluster",
        "Order": 0,
        "AuthorizationPolicy": "RequireManagerOrAdmin",
        "Match": {
          "Path": "/api/v1/media/manage/{**catch-all}",
          "Methods": ["GET"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Order": 100,
        "AuthorizationPolicy": "RequireAuthenticated",
        "Match": {
          "Path": "/api/v1/media/{**catch-all}",
          "Methods": ["GET", "POST", "DELETE"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:8080"
          }
        }
      },
      "catalog-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-service:8080"
          }
        }
      },
      "booking-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://booking-service:8080"
          }
        }
      },
      "chat-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://chat-service:8080"
          }
        }
      },
      "media-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://media-service:8080"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "_comment": "FailOpen: true = allow requests when Redis is down (availability); false = deny (fail-closed, stricter security). Default: true.",
    "FailOpen": true,
    "Global": {
      "Limit": 200,
      "PeriodSeconds": 60
    },
    "General": {
      "Limit": 100,
      "PeriodSeconds": 1
    },
    "Auth": {
      "Limit": 5,
      "PeriodSeconds": 1
    }
  },
  "Cors": {
    "_comment": "Production: Set explicit domain(s) in Cors:AllowedOrigins. Never use wildcard (*).",
    "AllowedOrigins": ["https://travelagency.com"],
    "AllowedMethods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Authorization", "Content-Type", "Accept", "X-Correlation-Id", "X-Request-ID", "Cache-Control"]
  },
  "Otel": {
    "Endpoint": "http://otel-collector:4317"
  },
  "HealthCheckEndpoints": {
    "Identity": "http://identity-service:8080/health/live",
    "Catalog": "http://catalog-service:8080/health/live",
    "Booking": "http://booking-service:8080/health/live",
    "Chat": "http://chat-service:8080/health/live",
    "Media": "http://media-service:8080/health/live"
  }
}
